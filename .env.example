SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=OPinox007@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM=OPinox007@gmail.com
ORDER_EMAIL_TO=OPinox007@gmail.com

# Stripe setup
# Add your real keys below and restart the dev server.
# Keep the publishable key in the client, and the secret key in the server.
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
APP_URL=http://localhost:3000

# Gmail setup:
# 1. Enable 2-Step Verification on the Gmail account.
# 2. Generate an App Password.
# 3. Paste the 16-character app password into SMTP_PASS.
# 4. Restart the dev server after saving .env.
# 5. If Stripe is enabled, fill in the Stripe keys above and restart again.
